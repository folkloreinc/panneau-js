{
    "name": "panneau-js",
    "private": true,
    "type": "module",
    "description": "Panneau: React packages for admin panels and content management",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/folkloreinc/panneau-js.git"
    },
    "license": "MIT",
    "engines": {
        "node": ">=24"
    },
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "node scripts/workspaces.js build",
        "typecheck": "node scripts/workspaces.js typecheck",
        "api": "node scripts/workspaces.js api",
        "api:check": "node scripts/workspaces.js api -- --check",
        "create-package": "node scripts/create-package.js",
        "test:create-package": "node scripts/check-create-package.js",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "changeset": "changeset",
        "version-packages": "changeset version && npm install --package-lock-only",
        "release": "npm run build && changeset publish",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "test:storybook": "vitest run --config vitest.storybook.config.ts"
    },
    "devDependencies": {
        "@babel/core": "^8.0.7",
        "@changesets/cli": "^3.0.3",
        "@eslint/js": "^10.0.1",
        "@internationalized/date": "^3.12.4",
        "@microsoft/api-extractor": "^7.59.4",
        "@rolldown/plugin-babel": "^0.2.4",
        "@storybook/addon-a11y": "^10.6.2",
        "@storybook/addon-vitest": "^10.6.2",
        "@storybook/react-vite": "^10.6.2",
        "@tanstack/react-query": "^5.104.3",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/node": "^24.0.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "@vitest/browser": "^5.0.5",
        "@vitest/browser-playwright": "^5.0.5",
        "babel-plugin-react-compiler": "^1.0.0",
        "bootstrap": "^5.3.8",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-storybook": "^10.6.2",
        "globals": "^17.13.0",
        "jsdom": "^30.1.2",
        "magic-string": "^1.4.3",
        "playwright": "^1.64.1",
        "prettier": "^3.9.10",
        "react": "^19.3.1",
        "react-aria-components": "^1.22.1",
        "react-dom": "^19.3.1",
        "react-intl": "^12.1.4",
        "storybook": "^10.6.2",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.71.2",
        "vite": "^8.3.4",
        "vitest": "^5.0.5"
    }
}
