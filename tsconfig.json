{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "noEmit": true,
        "types": ["node"],
        "customConditions": ["@panneau/source"],
        "allowImportingTsExtensions": true
    },
    "include": [
        "*.ts",
        "config/**/*.ts",
        ".storybook/**/*.ts",
        ".storybook/**/*.tsx",
        "mockups/**/*.ts",
        "mockups/**/*.tsx"
    ]
}
