    },
    "browser": {
        ".": "./dist/index.js",
        "./build": "./dist/build.cjs"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "clean": "rm -rf es && rm -rf lib && rm -rf dist",
        "build:ckeditor": "../../node_modules/.bin/webpack --mode production --config webpack.config.cjs",
        "prepublishOnly": "npm run build",
        "build": "rm -rf dist && ../../scripts/prepare-package.sh --types && npm run build:ckeditor"
    },
    "devDependencies": {
        "react": "^19.2.0",
        "react-dom": "^19.0.0"
