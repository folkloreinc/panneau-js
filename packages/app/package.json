{
    "name": "@panneau/app",
    "version": "5.0.0-alpha.2",
    "description": "The Panneau admin panel: the app entry (createPanneauApp), and the shell, routes and pages to come.",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/folkloreinc/panneau-js.git",
        "directory": "packages/app"
    },
    "sideEffects": [
        "*.css"
    ],
    "exports": {
        ".": {
            "@panneau/source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "vite build && tsc -p tsconfig.build.json",
        "typecheck": "tsc --noEmit",
        "api": "tsc -p tsconfig.build.json && node ../../scripts/api-report.js"
    },
    "publishConfig": {
        "access": "public"
    },
    "peerDependencies": {
        "@tanstack/react-query": "^5.0.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0"
    },
    "dependencies": {
        "@panneau/core": "5.0.0-alpha.2",
        "@panneau/data": "5.0.0-alpha.2",
        "@panneau/protocol": "5.0.0-alpha.2"
    }
}
