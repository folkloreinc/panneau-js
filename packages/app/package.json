{
    "name": "@panneau/app",
    "version": "5.0.0-alpha.7",
    "description": "The Panneau admin panel: the app entry (createPanneauApp), the shell with its sidebar, and the pages of resources.",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/folkloreinc/panneau-js.git",
        "directory": "packages/app"
    },
    "sideEffects": [
        "*.css"
    ],
    "exports": {
        ".": {
            "@panneau/source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "vite build && node ../../scripts/declarations.js",
        "typecheck": "tsc --noEmit",
        "api": "node ../../scripts/declarations.js && node ../../scripts/api-report.js"
    },
    "publishConfig": {
        "access": "public"
    },
    "peerDependencies": {
        "@tanstack/react-query": "^5.0.0",
        "react": "^19.2.0",
        "react-aria-components": "^1.22.0",
        "react-dom": "^19.2.0",
        "react-intl": "^12.0.0"
    },
    "dependencies": {
        "@panneau/actions": "5.0.0-alpha.7",
        "@panneau/core": "5.0.0-alpha.7",
        "@panneau/data": "5.0.0-alpha.7",
        "@panneau/fields": "5.0.0-alpha.7",
        "@panneau/forms": "5.0.0-alpha.7",
        "@panneau/intl": "5.0.0-alpha.7",
        "@panneau/lists": "5.0.0-alpha.7",
        "@panneau/protocol": "5.0.0-alpha.7",
        "@panneau/ui": "5.0.0-alpha.7",
        "lucide-react": "^1.57.0"
    }
}
