        "react-intl": "^12.0.0"
    },
    "peerDependenciesMeta": {
        "@uppy/aws-s3": {
            "optional": true
        },
        "@uppy/core": {
            "optional": true
        }
    },
    "dependencies": {
        "@internationalized/date": "^3.12.4",
        "@panneau/intl": "5.0.0-alpha.5",
        "@panneau/protocol": "5.0.0-alpha.5",
        "@panneau/ui": "5.0.0-alpha.5",
        "lucide-react": "^1.57.0"
    },
    "devDependencies": {
        "@uppy/aws-s3": "^6.3.0",
        "@uppy/core": "^6.3.0"
    }
