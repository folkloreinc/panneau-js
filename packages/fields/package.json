{
    "name": "@panneau/fields",
    "version": "5.0.0-alpha.5",
    "description": "Controlled field components of Panneau for the protocol's built-in field types, one subpath per field, and uploads to storage (Uppy 6 in its own entry point).",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/folkloreinc/panneau-js.git",
        "directory": "packages/fields"
    },
    "sideEffects": [
        "*.css"
    ],
    "exports": {
