{
    "name": "@panneau/actions",
    "version": "5.0.0-alpha.9",
    "description": "Runs the actions of lists and forms: parameters in a dialog, the action through a data adapter, its result, and queued runs.",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/folkloreinc/panneau-js.git",
        "directory": "packages/actions"
    },
    "sideEffects": [
        "*.css"
    ],
    "exports": {
        ".": {
            "@panneau/source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "vite build && node ../../scripts/declarations.js",
        "typecheck": "tsc --noEmit",
        "api": "node ../../scripts/declarations.js && node ../../scripts/api-report.js"
    },
    "publishConfig": {
        "access": "public"
    },
    "peerDependencies": {
        "react": "^19.2.0",
        "react-aria-components": "^1.22.0",
        "react-intl": "^12.0.0"
    },
    "dependencies": {
        "@panneau/core": "5.0.0-alpha.9",
        "@panneau/data": "5.0.0-alpha.9",
        "@panneau/forms": "5.0.0-alpha.9",
        "@panneau/intl": "5.0.0-alpha.9",
        "@panneau/protocol": "5.0.0-alpha.9",
        "@panneau/ui": "5.0.0-alpha.9",
        "lucide-react": "^1.57.0"
    },
    "devDependencies": {
        "@panneau/lists": "5.0.0-alpha.9"
    }
}
