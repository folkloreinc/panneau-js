{
    "name": "@panneau/protocol",
    "version": "5.0.0-alpha.0",
    "description": "The Panneau protocol: definition schema, HTTP API spec and conformance kit",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/folkloreinc/panneau-js.git",
        "directory": "packages/protocol"
    },
    "sideEffects": false,
    "exports": {
        ".": {
            "@panneau/source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./mock": {
            "@panneau/source": "./src/mock/index.ts",
            "types": "./dist/mock/index.d.ts",
            "default": "./dist/mock/index.js"
        },
        "./conformance": {
            "@panneau/source": "./src/conformance/index.ts",
            "types": "./dist/conformance/index.d.ts",
            "default": "./dist/conformance/index.js"
        },
        "./definition.schema.json": "./schema/definition.schema.json",
        "./openapi.json": "./schema/openapi.json",
        "./boot.schema.json": "./schema/boot.schema.json",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "schema"
    ],
    "scripts": {
        "build": "vite build && tsc -p tsconfig.build.json && node scripts/generate-schemas.js",
        "typecheck": "tsc --noEmit",
        "api": "tsc -p tsconfig.build.json && node ../../scripts/api-report.js"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "zod": "^4.6.7"
    }
}
