{
    "$id": "https://github.com/folkloreinc/panneau-js/blob/v5.x/packages/protocol/schema/agents.schema.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        "describe": {
            "type": "object",
            "properties": {
                "arguments": {
                    "$ref": "#/$defs/AgentDescribeArguments"
                },
                "result": {
                    "$ref": "#/$defs/AgentDescribeResult"
                }
            },
            "required": [
                "arguments",
                "result"
            ]
        },
        "find_items": {
            "type": "object",
            "properties": {
                "arguments": {
                    "$ref": "#/$defs/AgentFindItemsArguments"
                },
                "result": {
                    "$ref": "#/$defs/AgentFindItemsResult"
                }
            },
            "required": [
                "arguments",
                "result"
            ]
        },
        "get_item": {
            "type": "object",
            "properties": {
                "arguments": {
                    "$ref": "#/$defs/AgentGetItemArguments"
                },
                "result": {
                    "$ref": "#/$defs/Item"
                }
            },
            "required": [
                "arguments",
                "result"
            ]
        },
        "save_item": {
            "type": "object",
            "properties": {
                "arguments": {
                    "$ref": "#/$defs/AgentSaveItemArguments"
                },
                "result": {
                    "$ref": "#/$defs/Item"
                }
            },
            "required": [
                "arguments",
                "result"
            ]
        },
        "run_action": {
            "type": "object",
            "properties": {
                "arguments": {
                    "$ref": "#/$defs/AgentRunActionArguments"
                },
                "result": {
                    "$ref": "#/$defs/AgentRunActionResult"
                }
            },
            "required": [
                "arguments",
                "result"
            ]
        }
    },
    "required": [
        "describe",
        "find_items",
        "get_item",
        "save_item",
        "run_action"
    ],
    "$defs": {
        "AgentDescribeArguments": {
            "type": "object",
            "properties": {
                "resource": {
                    "type": "string",
                    "minLength": 1
                },
                "parts": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/AgentDescribePart"
                    }
                }
            },
            "additionalProperties": false
        },
        "AgentDescribePart": {
            "type": "string",
            "enum": [
                "fields",
                "list",
                "actions"
            ]
        },
        "AgentDescribeResult": {
            "anyOf": [
                {
                    "$ref": "#/$defs/AgentResourceList"
                },
                {
                    "$ref": "#/$defs/AgentResourceDescription"
                }
            ]
        },
        "AgentResourceList": {
            "type": "object",
            "properties": {
                "resources": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/AgentResourceSummary"
                    }
                },
                "context": {
                    "$ref": "#/$defs/DefinitionContext"
                }
            },
            "required": [
                "resources"
            ],
            "additionalProperties": {}
        },
        "AgentResourceSummary": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1
                },
                "label": {
                    "type": "object",
                    "properties": {
                        "singular": {
                            "type": "string"
                        },
                        "plural": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "singular",
                        "plural"
                    ],
                    "additionalProperties": {}
                },
                "description": {
                    "type": "string"
                },
                "abilities": {
                    "type": "object",
                    "properties": {
                        "viewAny": {
                            "type": "boolean"
                        },
                        "create": {
                            "type": "boolean"
                        }
                    },
                    "required": [
                        "viewAny",
                        "create"
                    ],
                    "additionalProperties": {}
                }
            },
            "required": [
                "id",
                "label",
                "abilities"
            ],
            "additionalProperties": {}
        },
        "DefinitionContext": {
            "type": "object",
            "properties": {
                "params": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/ContextParam"
                    }
                }
            },
            "required": [
                "params"
            ],
            "additionalProperties": {}
        },
        "ContextParam": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "pattern": "^(?!(?:resources|pages|media|search|account|auth)$)[A-Za-z_][A-Za-z0-9_]*$"
                },
                "label": {
                    "type": "string"
                },
                "required": {
                    "type": "boolean"
                },
                "fixed": {
                    "type": "boolean"
                },
                "allLabel": {
                    "type": "string"
                },
                "options": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/ContextOption"
                    }
                },
                "value": {
                    "anyOf": [
                        {
                            "type": "string",
                            "minLength": 1
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "valueLabel": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "required": [
                "name",
                "label"
            ],
            "additionalProperties": {}
        },
        "ContextOption": {
            "type": "object",
            "properties": {
                "value": {
                    "type": "string",
                    "minLength": 1
                },
                "label": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                }
            },
            "required": [
                "value",
                "label"
            ],
            "additionalProperties": {}
        },
        "AgentResourceDescription": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1
                },
                "label": {
                    "type": "object",
                    "properties": {
                        "singular": {
                            "type": "string"
                        },
                        "plural": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "singular",
                        "plural"
                    ],
                    "additionalProperties": {}
                },
                "description": {
                    "type": "string"
                },
                "fields": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/AgentField"
                    }
                },
                "types": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "string",
                                "minLength": 1
                            },
                            "label": {
                                "type": "string"
                            },
                            "description": {
                                "type": "string"
                            },
                            "fields": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/$defs/AgentField"
                                }
                            }
                        },
                        "required": [
                            "id",
                            "label",
                            "fields"
                        ],
                        "additionalProperties": {}
                    }
                },
                "list": {
                    "type": "object",
                    "properties": {
                        "filters": {
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/Filter"
                            }
                        },
                        "sorts": {
                            "type": "array",
                            "items": {
                                "type": "string",
                                "minLength": 1
                            }
                        },
                        "defaultSort": {
                            "type": "string"
                        },
                        "search": {
                            "type": "boolean"
                        }
                    },
                    "additionalProperties": {}
                },
                "actions": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/AgentAction"
                    }
                },
                "abilities": {
                    "type": "object",
                    "propertyNames": {
                        "type": "string"
                    },
                    "additionalProperties": {
                        "type": "boolean"
                    }
                }
            },
            "required": [
                "id",
                "label"
            ],
            "additionalProperties": {}
        },
        "AgentField": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "type": {
                    "type": "string",
                    "minLength": 1
                },
                "label": {
                    "type": "string"
                },
                "help": {
                    "type": "string"
                },
                "localized": {
                    "type": "boolean"
                },
                "required": {
                    "anyOf": [
                        {
                            "type": "boolean"
                        },
                        {
                            "type": "string",
                            "enum": [
                                "create",
                                "update"
                            ]
                        }
                    ]
                },
                "multiple": {
                    "type": "boolean"
                },
                "createOnly": {
                    "type": "boolean"
                },
                "updateOnly": {
                    "type": "boolean"
                },
                "readOnly": {
                    "type": "boolean"
                },
                "options": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/Option"
                    }
                },
                "resource": {
                    "anyOf": [
                        {
                            "type": "string",
                            "minLength": 1
                        },
                        {
                            "type": "array",
                            "items": {
                                "type": "string",
                                "minLength": 1
                            }
                        }
                    ]
                },
                "example": {},
                "fields": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/AgentField"
                    }
                },
                "types": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/AgentBlockType"
                    }
                }
            },
            "required": [
                "name",
                "type"
            ],
            "additionalProperties": {}
        },
        "Option": {
            "type": "object",
            "properties": {
                "value": {
                    "type": [
                        "string",
                        "number",
                        "boolean"
                    ]
                },
                "label": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "disabled": {
                    "type": "boolean"
                },
                "tone": {
                    "type": "string",
                    "pattern": "^[a-z0-9-]+$"
                }
            },
            "required": [
                "value",
                "label"
            ],
            "additionalProperties": {}
        },
        "AgentBlockType": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1
                },
                "label": {
                    "type": "string"
                },
                "fields": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/AgentField"
                    }
                }
            },
            "required": [
                "id",
                "label",
                "fields"
            ],
            "additionalProperties": {}
        },
        "Filter": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?!ids$)"
                },
                "type": {
                    "type": "string",
                    "minLength": 1
                },
                "label": {
                    "type": "string"
                },
                "options": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/Option"
                    }
                },
                "resource": {
                    "type": "string"
                },
                "multiple": {
                    "type": "boolean"
                },
                "default": {},
                "primary": {
                    "type": "boolean"
                }
            },
            "required": [
                "id",
                "type"
            ],
            "additionalProperties": {}
        },
        "AgentAction": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1
                },
                "label": {
                    "type": "string"
                },
                "scope": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/ActionScope"
                    }
                },
                "fields": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/AgentField"
                    }
                },
                "destructive": {
                    "type": "boolean"
                },
                "undoable": {
                    "type": "boolean"
                },
                "dryRun": {
                    "type": "boolean"
                },
                "confirmation": {
                    "type": "boolean"
                }
            },
            "required": [
                "id",
                "label",
                "scope"
            ],
            "additionalProperties": {}
        },
        "ActionScope": {
            "type": "string",
            "enum": [
                "item",
                "selection",
                "resource"
            ]
        },
        "AgentFindItemsArguments": {
            "type": "object",
            "properties": {
                "resource": {
                    "type": "string",
                    "minLength": 1
                },
                "q": {
                    "type": "string"
                },
                "limit": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 20
                },
                "filter": {
                    "type": "object",
                    "propertyNames": {
                        "type": "string"
                    },
                    "additionalProperties": {}
                },
                "sort": {
                    "type": "string",
                    "minLength": 1
                },
                "page": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                },
                "cursor": {
                    "type": "string",
                    "minLength": 1
                },
                "perPage": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 50
                },
                "fields": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            },
            "additionalProperties": false
        },
        "AgentFindItemsResult": {
            "anyOf": [
                {
                    "type": "object",
                    "properties": {
                        "data": {
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/AgentListItem"
                            }
                        },
                        "meta": {
                            "anyOf": [
                                {
                                    "$ref": "#/$defs/Pagination"
                                },
                                {
                                    "$ref": "#/$defs/CursorPagination"
                                }
                            ]
                        }
                    },
                    "required": [
                        "data",
                        "meta"
                    ],
                    "additionalProperties": {}
                },
                {
                    "type": "object",
                    "properties": {
                        "data": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "resource": {
                                        "type": "string"
                                    },
                                    "items": {
                                        "type": "array",
                                        "items": {
                                            "$ref": "#/$defs/AgentListItem"
                                        }
                                    },
                                    "total": {
                                        "type": "integer",
                                        "minimum": 0,
                                        "maximum": 9007199254740991
                                    }
                                },
                                "required": [
                                    "resource",
                                    "items"
                                ],
                                "additionalProperties": {}
                            }
                        }
                    },
                    "required": [
                        "data"
                    ],
                    "additionalProperties": {}
                }
            ]
        },
        "AgentListItem": {
            "type": "object",
            "properties": {
                "id": {
                    "$ref": "#/$defs/Id"
                },
                "version": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "abilities": {
                    "$ref": "#/$defs/Abilities"
                },
                "type": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "required": [
                "id",
                "version"
            ],
            "additionalProperties": {}
        },
        "Id": {
            "type": "string",
            "minLength": 1
        },
        "Abilities": {
            "type": "object",
            "propertyNames": {
                "type": "string"
            },
            "additionalProperties": {
                "type": "boolean"
            }
        },
        "Pagination": {
            "type": "object",
            "properties": {
                "page": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                },
                "perPage": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                },
                "total": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                },
                "lastPage": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                }
            },
            "required": [
                "page",
                "perPage",
                "total",
                "lastPage"
            ],
            "additionalProperties": {}
        },
        "CursorPagination": {
            "type": "object",
            "properties": {
                "perPage": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                },
                "nextCursor": {
                    "anyOf": [
                        {
                            "type": "string",
                            "minLength": 1
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "previousCursor": {
                    "anyOf": [
                        {
                            "type": "string",
                            "minLength": 1
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "total": {
                    "anyOf": [
                        {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            },
            "required": [
                "perPage",
                "nextCursor"
            ],
            "additionalProperties": {}
        },
        "AgentGetItemArguments": {
            "type": "object",
            "properties": {
                "resource": {
                    "type": "string",
                    "minLength": 1
                },
                "id": {
                    "$ref": "#/$defs/Id"
                },
                "fields": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            },
            "required": [
                "resource",
                "id"
            ],
            "additionalProperties": false
        },
        "Item": {
            "type": "object",
            "properties": {
                "id": {
                    "$ref": "#/$defs/Id"
                },
                "version": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "abilities": {
                    "$ref": "#/$defs/Abilities"
                },
                "type": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "required": [
                "id",
                "version",
                "abilities"
            ],
            "additionalProperties": {}
        },
        "AgentSaveItemArguments": {
            "type": "object",
            "properties": {
                "resource": {
                    "type": "string",
                    "minLength": 1
                },
                "id": {
                    "$ref": "#/$defs/Id"
                },
                "version": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "type": {
                    "type": "string",
                    "minLength": 1
                },
                "values": {
                    "type": "object",
                    "propertyNames": {
                        "type": "string"
                    },
                    "additionalProperties": {}
                }
            },
            "required": [
                "resource",
                "values"
            ],
            "additionalProperties": false
        },
        "AgentRunActionArguments": {
            "type": "object",
            "properties": {
                "resource": {
                    "type": "string",
                    "minLength": 1
                },
                "action": {
                    "type": "string",
                    "minLength": 1
                },
                "selection": {
                    "$ref": "#/$defs/Selection"
                },
                "values": {
                    "type": "object",
                    "propertyNames": {
                        "type": "string"
                    },
                    "additionalProperties": {}
                },
                "dryRun": {
                    "type": "boolean"
                },
                "confirmation": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "required": [
                "resource",
                "action"
            ],
            "additionalProperties": false
        },
        "Selection": {
            "anyOf": [
                {
                    "type": "object",
                    "properties": {
                        "ids": {
                            "minItems": 1,
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/Id"
                            }
                        }
                    },
                    "required": [
                        "ids"
                    ],
                    "additionalProperties": {}
                },
                {
                    "type": "object",
                    "properties": {
                        "query": {
                            "type": "object",
                            "properties": {
                                "filter": {
                                    "type": "object",
                                    "propertyNames": {
                                        "type": "string"
                                    },
                                    "additionalProperties": {}
                                },
                                "q": {
                                    "type": "string"
                                }
                            },
                            "additionalProperties": {}
                        },
                        "except": {
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/Id"
                            }
                        }
                    },
                    "required": [
                        "query"
                    ],
                    "additionalProperties": {}
                }
            ]
        },
        "AgentRunActionResult": {
            "anyOf": [
                {
                    "$ref": "#/$defs/AgentConfirmationRequired"
                },
                {
                    "type": "object",
                    "properties": {
                        "message": {
                            "type": "string"
                        },
                        "summary": {
                            "type": "object",
                            "properties": {
                                "succeeded": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 9007199254740991
                                },
                                "failed": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 9007199254740991
                                },
                                "skipped": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 9007199254740991
                                }
                            },
                            "required": [
                                "succeeded",
                                "failed",
                                "skipped"
                            ],
                            "additionalProperties": {}
                        },
                        "results": {
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/ActionItemResult"
                            }
                        },
                        "refresh": {
                            "type": "string",
                            "enum": [
                                "none",
                                "items",
                                "list"
                            ]
                        },
                        "redirect": {
                            "anyOf": [
                                {
                                    "anyOf": [
                                        {
                                            "type": "string"
                                        },
                                        {
                                            "$ref": "#/$defs/RouteReference"
                                        }
                                    ]
                                },
                                {
                                    "type": "null"
                                }
                            ]
                        },
                        "download": {
                            "anyOf": [
                                {
                                    "type": "object",
                                    "properties": {
                                        "url": {
                                            "type": "string"
                                        },
                                        "filename": {
                                            "type": "string"
                                        },
                                        "expiresAt": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "url"
                                    ],
                                    "additionalProperties": {}
                                },
                                {
                                    "type": "null"
                                }
                            ]
                        },
                        "undo": {
                            "type": "object",
                            "properties": {
                                "action": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "items": {
                                    "minItems": 1,
                                    "maxItems": 100,
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/$defs/Id"
                                    }
                                },
                                "params": {
                                    "type": "object",
                                    "propertyNames": {
                                        "type": "string"
                                    },
                                    "additionalProperties": {}
                                }
                            },
                            "required": [
                                "action",
                                "items"
                            ],
                            "additionalProperties": {}
                        },
