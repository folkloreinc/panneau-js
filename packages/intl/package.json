{
    "name": "@panneau/intl",
    "version": "5.0.0-alpha.8",
    "description": "The UI messages of the Panneau packages, in English and French, with helpers to merge them with an app's messages.",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/folkloreinc/panneau-js.git",
        "directory": "packages/intl"
    },
    "sideEffects": false,
    "exports": {
        ".": {
            "@panneau/source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "vite build && node ../../scripts/declarations.js",
        "typecheck": "tsc --noEmit",
        "api": "node ../../scripts/declarations.js && node ../../scripts/api-report.js"
    },
    "publishConfig": {
        "access": "public"
    },
    "peerDependencies": {
        "react-intl": "^12.0.0"
    }
}
