    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "style": "./assets/css/styles.css",
            "default": "./dist/index.js"
        },
        "./assets/css/styles": "./assets/css/styles.css",
        "./assets/css/styles.css": "./assets/css/styles.css",
        "./assets/css/vendor": "./assets/css/vendor.css",
        "./assets/css/vendor.css": "./assets/css/vendor.css",
        "./assets/css/variables": "./assets/css/variables.css",
        "./assets/css/variables.css": "./assets/css/variables.css"
    },
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "style": "assets/css/styles.css",
    "files": [
        "dist",
        "assets"
    ],
    "scripts": {
        "build": "../../scripts/prepare-package.sh --types && npm run css",
        "css": "npm run css:styles && npm run css:vendor && npm run css:copy",
        "css:copy": "cp src/styles/variables.css assets/css/variables.css",
        "css:styles": "postcss src/styles/styles.css -o assets/css/styles.css",
        "css:vendor": "postcss src/styles/vendor.css -o assets/css/vendor.css",
        "prepublishOnly": "npm run build"
    },
    "dependencies": {
        "@babel/runtime": "^7.28.6",
        "@panneau/core": "^4.0.58",
        "bootstrap": "^5.3.8",
        "classnames": "^2.5.1",
        "lodash": "^4.17.21"
    },
    "devDependencies": {
        "react": "^19.2.0",
        "react-dom": "^19.0.0"
    },
    "peerDependencies": {
        "react": "^19.2.0",
        "react-dom": "^19.0.0"
    },
    "publishConfig": {
        "access": "public"
