{
    "name": "@panneau/media",
    "version": "5.0.0-alpha.9",
    "description": "The media of Panneau: the media field, which makes media of uploads and follows their ingest.",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/folkloreinc/panneau-js.git",
        "directory": "packages/media"
    },
    "sideEffects": [
        "*.css"
    ],
    "exports": {
        ".": {
            "@panneau/source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./picker": {
            "@panneau/source": "./src/picker/index.ts",
            "types": "./dist/picker/index.d.ts",
            "default": "./dist/picker/index.js"
        },
        "./editor": {
            "@panneau/source": "./src/editor/index.ts",
            "types": "./dist/editor/index.d.ts",
            "default": "./dist/editor/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "vite build && node ../../scripts/declarations.js",
        "typecheck": "tsc --noEmit",
        "api": "node ../../scripts/declarations.js && node ../../scripts/api-report.js"
    },
    "publishConfig": {
        "access": "public"
    },
    "peerDependencies": {
        "@tanstack/react-query": "^5.0.0",
        "react": "^19.2.0",
        "react-aria-components": "^1.22.0",
        "react-intl": "^12.0.0"
    },
    "dependencies": {
        "@panneau/core": "5.0.0-alpha.9",
        "@panneau/data": "5.0.0-alpha.9",
        "@panneau/fields": "5.0.0-alpha.9",
        "@panneau/intl": "5.0.0-alpha.9",
        "@panneau/protocol": "5.0.0-alpha.9",
        "@panneau/ui": "5.0.0-alpha.9",
        "lucide-react": "^1.57.0"
    }
}
