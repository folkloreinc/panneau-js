{
    "name": "@panneau/ui",
    "version": "5.0.0-alpha.8",
    "description": "Design tokens, themes and accessible primitives of Panneau, built on React Aria Components.",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/folkloreinc/panneau-js.git",
        "directory": "packages/ui"
    },
    "sideEffects": [
        "*.css"
    ],
    "exports": {
        ".": {
            "@panneau/source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./locales": {
            "@panneau/source": "./src/locales/index.ts",
            "types": "./dist/locales/index.d.ts",
            "default": "./dist/locales/index.js"
        },
        "./named-icons": {
            "@panneau/source": "./src/named-icons/index.ts",
            "types": "./dist/named-icons/index.d.ts",
            "default": "./dist/named-icons/index.js"
        },
        "./theme": {
            "@panneau/source": "./src/theme/index.ts",
            "types": "./dist/theme/index.d.ts",
            "default": "./dist/theme/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "bin"
    ],
    "bin": {
        "panneau-check-theme": "./bin/check-theme.js"
    },
    "scripts": {
        "build": "vite build && node ../../scripts/declarations.js",
        "typecheck": "tsc --noEmit",
        "api": "node ../../scripts/declarations.js && node ../../scripts/api-report.js"
    },
    "publishConfig": {
        "access": "public"
    },
    "peerDependencies": {
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-aria-components": "^1.22.0",
        "react-intl": "^12.0.0"
    },
    "dependencies": {
        "@panneau/intl": "5.0.0-alpha.8",
        "lucide-react": "^1.57.0"
    },
    "devDependencies": {
        "@panneau/protocol": "5.0.0-alpha.8"
    }
}
